
/*========== Configuration ==========*/
configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               "";
    drun-display-format:        "{name}";
}

/*========== Variables ==========*/
* {
    /* fonts */
    font:                       "CaskaydiaCove Nerd Font Propo 12";

    /* colors */
    background:                 #16161e;
    background-alt:             #1f2335;
    foreground:                 #c0caf5;
    foreground-alt:             #a9b1d6;
    selected:                   #7aa2f7;
    active:                     #9ece6a;
    urgent:                     #f7768e;
}

/*========== Main Window ==========*/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      560px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    20px;
    border:                     0px solid;
    border-radius:              20px;
    border-color:               @selected;
    background-color:           @background;
    cursor:                     "default";
}

/*========== Main Box ==========*/
mainbox {
    enabled:                    true;
    spacing:                    14px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

/*========== Inputbar ==========*/
inputbar {
    enabled:                    true;
    spacing:                    8px;
    margin:                     0px;
    padding:                    10px 14px;
    border:                     0px solid;
    border-radius:              12px;
    background-color:           @background-alt;
    text-color:                 @foreground-alt;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "󰍉";
    background-color:           inherit;
    text-color:                 @selected;
}

entry {
    enabled:                    true;
    padding:                    0px;
    background-color:           inherit;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                "Search apps...";
    placeholder-color:          inherit;
}

/*========== Listview ==========*/
listview {
    enabled:                    true;
    columns:                    4;
    lines:                      3;
    cycle:                      true;
    dynamic:                    false;
    scrollbar:                  false;
    layout:                     vertical;
    flow:                       horizontal;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    12px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     "default";
}

/*========== Elements ==========*/
element {
    enabled:                    true;
    orientation:                vertical;
    spacing:                    6px;
    margin:                     0px;
    padding:                    8px 4px;
    border:                     2px solid;
    border-radius:              12px;
    border-color:                transparent;
    background-color:           transparent;
    text-color:                 @foreground-alt;
    cursor:                     pointer;
}

element normal.normal {
    border-color:               transparent;
    background-color:           transparent;
    text-color:                 @foreground-alt;
}

element alternate.normal {
    border-color:               transparent;
    background-color:           transparent;
    text-color:                 @foreground-alt;
}

element selected.normal {
    border-color:               @selected;
    background-color:           @background-alt;
    text-color:                 @foreground;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       32px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    font:                       @font;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    margin:                     3px 0px 0px 0px;
}

/*========== Error Message ==========*/
error-message {
    padding:                    15px;
    border:                     2px solid;
    border-radius:              12px;
    border-color:               @selected;
    background-color:           @background;
    text-color:                 @foreground;
}

textbox {
    background-color:           @background;
    text-color:                 @foreground;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    highlight:                  none;
}
