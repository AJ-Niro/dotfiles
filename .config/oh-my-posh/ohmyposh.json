{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "template": "<white,transparent>❯</> ",
    "background": "transparent",
    "newline": true
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "style": "diamond",
          "leading_diamond": "\n",
          "trailing_diamond": "",
          "template": "{{.Icon}} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "os"
        },
        {
          "style": "diamond",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "session"
        },
        {
          "style": "diamond",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "template": "  {{ .Path }} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "path"
        },
        {
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "git"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "❯",
          "foreground": "white",
          "type": "status",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
