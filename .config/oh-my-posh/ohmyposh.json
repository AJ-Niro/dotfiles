{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "template": "<white,transparent>❯</> ",
    "background": "transparent",
    "newline": true
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "style": "diamond",
          "template": "{{.Icon}} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "os",
          "leading_diamond": "\n",
          "trailing_diamond": ""
        },
        {
          "style": "diamond",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "session",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": ""
        },
        {
          "style": "diamond",
          "template": " {{ .Var.path_dir }} {{ .Path }} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "path",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": ""
        },
        {
          "options": {
            "fetch_status": true
          },
          "style": "diamond",
          "template": " {{ .HEAD }}{{ if .Ahead }} {{ .Var.git_ahead }}{{ .Ahead }}{{ end }}{{ if .Behind }} {{ .Var.git_behind }}{{ .Behind }}{{ end }}{{ if .UpstreamGone }} {{ .Var.git_upstream_gone }}{{ end }}{{ if .Rebase }} {{ .Var.git_rebase }} rebase{{ end }}{{ if .Merge }} {{ .Var.git_merge }} merge{{ end }}{{ if .CherryPick }} {{ .Var.git_cherry_pick }} cherry-pick{{ end }}{{ if .Staging.Changed }} {{ .Var.git_staged }}{{ if .Staging.Added }} +{{ .Staging.Added }}{{ end }}{{ if .Staging.Modified }} ~{{ .Staging.Modified }}{{ end }}{{ if .Staging.Deleted }} -{{ .Staging.Deleted }}{{ end }}{{ end }}{{ if and .Working.Changed .Staging.Changed }} |{{ end }}{{ if .Working.Changed }} {{ .Var.git_unstaged }}{{ if .Working.Added }} +{{ .Working.Added }}{{ end }}{{ if .Working.Modified }} ~{{ .Working.Modified }}{{ end }}{{ if .Working.Deleted }} -{{ .Working.Deleted }}{{ end }}{{ end }}{{ if gt .StashCount 0 }} {{ .Var.git_stash }} {{ .StashCount }}{{ end }} ",
          "foreground": "black",
          "background": "darkGray",
          "type": "git",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": ""
        },
        {
          "type": "go",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_go }} {{ .Full }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h"
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_python }}{{ if .Venv }} {{ .Venv }}{{ end }} {{ .Full }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_node }} {{ .Full }}{{ if .PackageManagerIcon }} {{ .PackageManagerIcon }}{{ end }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h",
            "fetch_package_manager": true
          }
        },
        {
          "type": "lua",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_lua }} {{ .Full }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h"
          }
        },
        {
          "type": "kotlin",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_kotlin }} {{ .Full }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h"
          }
        },
        {
          "type": "java",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_java }} {{ .Full }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h"
          }
        },
        {
          "type": "rust",
          "style": "diamond",
          "foreground": "black",
          "background": "darkGray",
          "template": " {{ .Var.lang_rust }} {{ .Full }} ",
          "leading_diamond": "<transparent,darkGray></>",
          "trailing_diamond": "",
          "options": {
            "display_mode": "files",
            "cache_duration": "24h"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "❯",
          "foreground": "white",
          "type": "status",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true,
  "var": {
    "git_ahead": "↑",
    "git_behind": "↓",
    "git_upstream_gone": "",
    "git_rebase": "",
    "git_merge": "",
    "git_cherry_pick": "",
    "git_staged": "",
    "git_unstaged": "",
    "git_stash": "",
    "path_dir": "",
    "prompt_arrow": "❯",
    "lang_go": "",
    "lang_python": "",
    "lang_node": "",
    "lang_lua": "",
    "lang_kotlin": "",
    "lang_java": "",
    "lang_rust": ""
  }
}
